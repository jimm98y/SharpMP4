<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMP4Common\SharpMP4Common.csproj" />
  </ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- no baseline until this library has a published version; still checks its target frameworks agree -->
	</PropertyGroup>

</Project>
