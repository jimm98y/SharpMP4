<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SharpAV1\SharpAV1.csproj" />
		<ProjectReference Include="..\SharpAV2\SharpAV2.csproj" />
		<ProjectReference Include="..\SharpH264\SharpH264.csproj" />
		<ProjectReference Include="..\SharpH265\SharpH265.csproj" />
		<ProjectReference Include="..\SharpH266\SharpH266.csproj" />
		<ProjectReference Include="..\SharpISOBMFF\SharpISOBMFF.csproj" />
		<ProjectReference Include="..\SharpMP4Common\SharpMP4Common.csproj" />
		<ProjectReference Include="..\SharpVP9\SharpVP9.csproj" />
		<ProjectReference Include="..\SharpH261\SharpH261.csproj" />
		<ProjectReference Include="..\SharpProRes\SharpProRes.csproj" />
		<ProjectReference Include="..\SharpH262\SharpH262.csproj" />
		<ProjectReference Include="..\SharpH263\SharpH263.csproj" />
		<ProjectReference Include="..\SharpMPEG4\SharpMPEG4.csproj" />
	</ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.3.2</PackageValidationBaselineVersion>
	</PropertyGroup>

</Project>
