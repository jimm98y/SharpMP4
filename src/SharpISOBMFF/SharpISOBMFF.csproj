<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net481;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<!-- Used to enable/disable the source code generator -->
		<AutoGenerateCode>true</AutoGenerateCode>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<AdditionalFiles Include="Definitions\14496-1-boxes-added.json" />
		<AdditionalFiles Include="Definitions\14496-12-boxes-added.json" />
		<AdditionalFiles Include="Definitions\14496-12-boxes.json" />
		<AdditionalFiles Include="Definitions\14496-12-codecs.json" />
		<AdditionalFiles Include="Definitions\14496-12-entity-groups.json" />
		<AdditionalFiles Include="Definitions\14496-12-item-properties.json" />
		<AdditionalFiles Include="Definitions\14496-12-item-references.json" />
		<AdditionalFiles Include="Definitions\14496-12-sample-groups.json" />
		<AdditionalFiles Include="Definitions\14496-12-track-groups.json" />
		<AdditionalFiles Include="Definitions\14496-12-track-references.json" />
		<AdditionalFiles Include="Definitions\14496-15-boxes-added.json" />
		<AdditionalFiles Include="Definitions\14496-15-boxes.json" />
		<AdditionalFiles Include="Definitions\14496-15-codecs.json" />
		<AdditionalFiles Include="Definitions\14496-15-entity-groups.json" />
		<AdditionalFiles Include="Definitions\14496-15-sample-groups.json" />
		<AdditionalFiles Include="Definitions\14496-15-track-groups.json" />
		<AdditionalFiles Include="Definitions\14496-15-track-references.json" />
		<AdditionalFiles Include="Definitions\14496-23-boxes-added.json" />
		<AdditionalFiles Include="Definitions\14496-3-boxes-added.js" />
		<AdditionalFiles Include="Definitions\14496-3-boxes-added.json" />
		<AdditionalFiles Include="Definitions\14496-30-boxes.json" />
		<AdditionalFiles Include="Definitions\23008-12-boxes.json" />
		<AdditionalFiles Include="Definitions\23008-12-entity-groups.json" />
		<AdditionalFiles Include="Definitions\23008-12-item-properties.json" />
		<AdditionalFiles Include="Definitions\23008-12-item-references.json" />
		<AdditionalFiles Include="Definitions\23008-12-sample-groups.json" />
		<AdditionalFiles Include="Definitions\Added-boxes.json" />
		<AdditionalFiles Include="Definitions\AV1-boxes.json" />
		<AdditionalFiles Include="Definitions\AV2-boxes.json" />
		<AdditionalFiles Include="Definitions\AVIF-boxes.json" />
		<AdditionalFiles Include="Definitions\QuickTime-boxes.json" />
		<AdditionalFiles Include="Definitions\Opus-boxes.json" />
		<AdditionalFiles Include="Definitions\FLAC-boxes.json" />
		<AdditionalFiles Include="Definitions\AC4-boxes.json" />
		<AdditionalFiles Include="Definitions\DTSUHD-boxes.json" />
		<AdditionalFiles Include="Definitions\IAMF-boxes.json" />
	</ItemGroup>

	<ItemGroup Condition="$(AutoGenerateCode) == 'true'">
		<ProjectReference Include="..\BoxGenerator\BoxGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
		<None Include="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Generated\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SharpMP4Common\SharpMP4Common.csproj" />
	</ItemGroup>
	<PropertyGroup Condition="$(AutoGenerateCode) == 'true'">
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<GeneratedFolder>Generated</GeneratedFolder>
		<CompilerGeneratedFilesOutputPath>$(GeneratedFolder)</CompilerGeneratedFilesOutputPath>
	</PropertyGroup>

	<!-- Boxes.md at the root of the repository: the list of boxes the generator gives with their code, in a
	     comment of Boxes.md.g.cs. Once, not by each target framework's build at the same time. -->
	<UsingTask TaskName="WriteBoxListFromComment" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
		<ParameterGroup>
			<Source ParameterType="System.String" Required="true" />
			<Destination ParameterType="System.String" Required="true" />
		</ParameterGroup>
		<Task>
			<Code Type="Fragment" Language="cs"><![CDATA[
				// the markdown between /* and */, as the generator wrote it; the file written only when it changes
				string text = System.IO.File.ReadAllText(Source);
				int start = text.IndexOf("/*") + 2, end = text.LastIndexOf("*/");
				string list = text.Substring(start, end - start).Trim('\r', '\n');
				if (!System.IO.File.Exists(Destination) || System.IO.File.ReadAllText(Destination) != list)
					System.IO.File.WriteAllText(Destination, list);
			]]></Code>
		</Task>
	</UsingTask>
	<Target Name="WriteBoxList" AfterTargets="CoreCompile" Condition="$(AutoGenerateCode) == 'true' And '$(TargetFramework)' == 'net10.0' And Exists('$(CompilerGeneratedFilesOutputPath)\BoxGenerator\BoxGenerator.SourceGenerator\Boxes.md.g.cs')">
		<WriteBoxListFromComment Source="$(MSBuildProjectDirectory)\$(CompilerGeneratedFilesOutputPath)\BoxGenerator\BoxGenerator.SourceGenerator\Boxes.md.g.cs" Destination="$(MSBuildProjectDirectory)\..\..\Boxes.md" />
	</Target>

</Project>
