<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpH264\SharpH264.csproj" />
    <ProjectReference Include="..\SharpISOBMFF\SharpISOBMFF.csproj" />
    <ProjectReference Include="..\SharpMP4\SharpMP4.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The harness runs against a committed file, so it needs nothing from outside the repo. -->
    <Content Include="..\SampleVideoParser\bunny.mp4" Link="bunny.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
